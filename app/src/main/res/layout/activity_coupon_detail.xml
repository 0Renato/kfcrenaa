<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kfc_white">

    <!-- Header -->
    <RelativeLayout
        android:id="@+id/headerCoupon"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/kfc_red">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Voltar"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Detalhes do Cupom"
            android:textColor="@color/kfc_white"
            android:textSize="20sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerCoupon"
        android:layout_above="@id/btnCopyCode">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <ImageView
                android:id="@+id/imgCouponLarge"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:scaleType="centerInside"
                android:src="@drawable/cupbalde"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:id="@+id/tvCouponTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="30% OFF no Balde Tradicional"
                android:textColor="@color/kfc_black"
                android:textSize="24sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvCouponExpiry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Válido até: 31/12/2026"
                android:textColor="@color/kfc_dark_grey"
                android:textSize="16sp"
                android:layout_marginTop="8dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/kfc_grey"
                android:layout_marginVertical="24dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Regras da Oferta:"
                android:textColor="@color/kfc_black"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_gravity="start"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:id="@+id/tvCouponRules"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Cupom válido apenas para pedidos via aplicativo.\n• Limite de 1 uso por CPF.\n• Não cumulativo com outras promoções.\n• Válido para o Balde Tradicional de 10 ou 15 pedaços."
                android:textColor="@color/kfc_dark_grey"
                android:textSize="16sp"
                android:lineSpacingExtra="6dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/kfc_grey"
                android:padding="16dp"
                android:layout_marginTop="32dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Código do Cupom:"
                    android:textSize="14sp"
                    android:textColor="@color/kfc_dark_grey"/>

                <TextView
                    android:id="@+id/tvCouponCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="KFC30OFF"
                    android:textColor="@color/kfc_red"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnCopyCode"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:layout_margin="16dp"
        android:backgroundTint="@color/kfc_black"
        android:text="COPIAR CÓDIGO"
        android:textColor="@color/kfc_white"
        android:textStyle="bold"
        android:textSize="18sp"/>

</RelativeLayout>