<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- KFC Modern Theme based on Material 3 -->
    <style name="Theme.KFCRena" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/kfc_red</item>
        <item name="colorOnPrimary">@color/kfc_white</item>
        <item name="colorPrimaryContainer">#FFEBEE</item>
        <item name="colorOnPrimaryContainer">@color/kfc_red_dark</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/kfc_black</item>
        <item name="colorOnSecondary">@color/kfc_white</item>

        <!-- Background and Surface -->
        <item name="android:windowBackground">@color/surface_background</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/divider_color</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/kfc_red</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>

        <!-- Component Styles -->
        <item name="materialButtonStyle">@style/Widget.KFC.Button</item>
        <item name="cardViewStyle">@style/Widget.KFC.Card</item>
    </style>

    <!-- Custom Button Style -->
    <style name="Widget.KFC.Button" parent="Widget.Material3.Button">
        <item name="shapeAppearance">@style/ShapeAppearance.KFC.Medium</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Custom Card Style -->
    <style name="Widget.KFC.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
    </style>

    <style name="ShapeAppearance.KFC.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearance.KFC.TopRounded" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
</resources>